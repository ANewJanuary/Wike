<!-- About Wike dialog -->
<interface>
  <object class="AdwAboutDialog" id="about_dialog">
    <property name="application-icon">com.github.ANewJanuary.WikeSauce</property>
    <property name="application-name">WikeSauce</property>
    <property name="developer-name">Hugo Olabera</property>
    <property name="version">3.3.0</property>
    <property name="comments" translatable="yes">Search and read Wikipedia articles</property>
    <property name="website">https://github.com/ANewJanuary/Wike</property>
    <property name="translator-credits" translatable="yes">translator-credits</property>
    <property name="copyright">Copyright © 2021-25 Hugo Olabera</property>
    <property name="license-type">GTK_LICENSE_GPL_3_0</property>
  </object>
</interface>
