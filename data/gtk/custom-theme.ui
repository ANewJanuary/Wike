<!-- Custom theme dialog -->
<interface>
  <template class="CustomThemeDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Custom Theme</property>
    <property name="content-height">540</property>
    <property name="content-width">480</property>

    <!-- Custom theme page -->
    <child>
      <object class="AdwPreferencesPage">

        <!-- Group base style -->
        <child>
          <object class="AdwPreferencesGroup">

            <!-- Base style selector -->
            <child>
              <object class="AdwComboRow" id="base_combo">
                <property name="title" translatable="yes">Base Style</property>
                <property name="subtitle" translatable="yes">Used for everything not set below</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Light</item>
                      <item translatable="yes">Dark</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </child>

        <!-- Group transparency -->
        <child>
          <object class="AdwPreferencesGroup">

            <!-- Background opacity slider -->
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Background Opacity</property>
                <property name="subtitle" translatable="yes">Text and images stay opaque</property>

                <child>
                  <object class="GtkScale" id="opacity_scale">
                    <property name="hexpand">true</property>
                    <property name="valign">center</property>
                    <property name="draw-value">true</property>
                    <property name="value-pos">left</property>
                    <property name="digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">20</property>
                        <property name="upper">100</property>
                        <property name="step-increment">5</property>
                        <property name="page-increment">10</property>
                      </object>
                    </property>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>

        <!-- Group colors (rows added in code) -->
        <child>
          <object class="AdwPreferencesGroup" id="colors_group">
            <property name="title" translatable="yes">Colors</property>
            <property name="description" translatable="yes">Enable a color to override the base style</property>
          </object>
        </child>

      </object>
    </child>

  </template>
</interface>
